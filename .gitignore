# ============================================================
# SkyGuard AI -- .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
env/
venv/
.venv/
ENV/
pip-log.txt
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.pytype/
*.pyo
*.pyd

# --- Jupyter Notebooks ---
.ipynb_checkpoints/

# --- Environment Variables ---
.env
.env.local
.env.*.local
!.env.example

# --- Node / React / Vite ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- ML Models (Temporary models dir ignored, pre-trained saved_models tracked for deployment) ---
models/*.joblib
models/*.pt
models/*.pkl
models/*.h5

# --- Data Files (large CSVs -- never commit) ---
data/raw/*.csv
data/processed/*.csv
data/injected/*.csv
data/splits/*.csv
data/metadata/*.csv

# Keep directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/injected/.gitkeep
!data/splits/.gitkeep
!data/metadata/.gitkeep
!models/.gitkeep
!ml/saved_models/.gitkeep

# --- Database ---
*.db
*.sqlite
*.sqlite3

# --- Docker ---
docker-compose.override.yml

# --- OS Artifacts ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo

# --- Logs ---
logs/
*.log
backend/logs/

# --- Test artifacts ---
coverage.xml
test-results/

# Root-level dataset file
Abohar.csv
*.csv
