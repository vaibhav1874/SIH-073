# ============================================================
# SkyGuard AI — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Database ---
# SQLite (default - zero setup, great for demo)
DATABASE_URL=sqlite+aiosqlite:///./skyguard.db
# PostgreSQL (production - switch here)
# DATABASE_URL=postgresql+asyncpg://skyguard:password@localhost:5432/skyguard

# --- ML Model Paths ---
MODELS_DIR=./ml/saved_models
DATA_DIR=./data

# --- Ensemble Weights (must sum to 1.0) ---
RULE_WEIGHT=0.35
IF_WEIGHT=0.35
LSTM_WEIGHT=0.30

# --- Anomaly Detection Threshold (0-100) ---
ANOMALY_THRESHOLD=55.0

# --- Anomaly Injection ---
INJECTION_SEED=42
ANOMALY_TARGET_RATE=0.07

# --- Simulator ---
SIMULATOR_SPEED_SECONDS=1.0
SIMULATOR_DEFAULT_MODE=normal
SIMULATOR_CSV_PATH=./data/injected/Abohar_anomaly.csv

# --- SHAP Explainability (set false to skip for speed) ---
ENABLE_SHAP=true

# --- CORS ---
FRONTEND_URL=http://localhost:3000

# --- App ---
APP_NAME=SkyGuard AI
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
